# Address of the computer running the gateway on the heater's network.
ICOMM_LOCAL_IP=192.168.2.1

# Host ports. Change these only if they conflict with another service.
ICOMM_DASHBOARD_PORT=8788
ICOMM_TLS_PORT=8443
ICOMM_DNS_PORT=1053
ICOMM_ANS_PORT=15555

# Optional. Normally learned from the heater's first HTTPS request.
ICOMM_DEVICE_ID=

# Keep raw ANS packet bodies out of logs unless actively researching.
ICOMM_DEBUG_PACKETS=false
ICOMM_DNS_CAPTURE_ALL=true
