# Bind to the Docker host's reserved LAN IP for a physical heater test.
# Loopback is sufficient for the synthetic smoke test.
BIND_IP=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80
# Admin UI address. Set to a host LAN IP for direct LAN access.
STATUS_BIND_IP=127.0.0.1
STATUS_PORT=8789
ANS_PORT=55055
MQTT_URL=mqtt://YOUR_HOME_ASSISTANT_IP:1883
MQTT_USERNAME=icomm
MQTT_PASSWORD=REPLACE_WITH_A_DEDICATED_BROKER_PASSWORD
DEVICE_NAME=A. O. Smith water heater
DEVICE_PROFILE=reselec3
# Optional: pin the private numeric device ID. Otherwise the first ID is learned.
DEVICE_ID=
READ_ONLY=true
GATEWAY_MODE=local
# Bridge mode only: set the exact device-service hostname seen in AdGuard.
CLOUD_HOST=
# Independent resolver prevents the AdGuard rewrite looping back to this gateway.
UPSTREAM_DNS=1.1.1.1
# Full HTTP headers/bodies and raw UDP packets; stored privately, never in source control.
CAPTURE_MODE=redacted
